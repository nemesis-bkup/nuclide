		itemDef
		{
			name ArmorValue
			rect 390 432 61 32
			forecolor 1 1 1 1
			ownerdraw CG_PLAYER_ARMOR_VALUE
			decoration
			visible 1
			text "100"
		}
	}

	menuDef
	{
		name "Weapon Info"
		rect 0 0 640 480
		visible 1

		itemDef
		{
			name WeaponIcon
			rect 594 432 32 32
			forecolor 1 1 1 1
