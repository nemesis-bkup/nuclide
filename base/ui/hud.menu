#include "ui/menudef.h"

{
	assetglobaldef
	{
		font fonts/font16 16
		smallfont fonts/smallFont 8
	}

	menuDef
	{
		name "StaminaBar"
		visible 1
		border 1
		bordersize 1
		bordercolor .25 .25 .25 1
		rect 10 400 10 70

		itemDef
		{
				name "StaminaValue"
				decoration
				visible 1
				rect 0 0 8 68
				ownerdraw CG_PLAYER_STAMINA
				type 8
				forecolor 1 1 1 1
		}
	}

	menuDef
	{
		name "LocationBar"
