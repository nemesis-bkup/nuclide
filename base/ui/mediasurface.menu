			type 32
			rect 0 0 640 480
			visible 0
		}

		itemDef
		{
			name shared_video
			group sharedItem
			rect 0 0 640 480
			visible 0
			type 34
		}

		itemDef
		{
			name shared_picture
			group sharedItem
			rect 0 0 640 480
			visible 0
			style 3
			type 35
		}

		itemDef
		{
			name shared_audio
