// oneflag ctf

// the thing the teams are each trying to steal
entityDef team_CTF_neutralflag
{
        "inherit"           "ctf_baseflag"
        "rendercolor"       "255 255 255"
        "goal_no"           "0"
        "skin"              "0"
        "model"             "models/flag.vvm"
        "script_gametype"   "oneflagctf"

        "OnCapture"         "!rules,capture,2,0.0,-1"
        "OnReturn"          "!rules,return,2,0.0,-1"
        "OnTake"            "!rules,take,2,0.0,-1"
}

// capture points, in oneflag you have to deliver the neutral-flag to the opposite teams' base
