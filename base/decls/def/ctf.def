entityDef ctf_basepoint
{
        "spawnclass"        "ncCapturePoint"
        "mins"              "-16 -16 0"
        "maxs"              "16 16 72"
        "model"             "models/flag.vvm"
        "dropToFloor"       "1"
        "goalItem"          "ctf_flag"
        "script_gametype"   "ctf"
        "rendermode"        "0"
        "renderamt"         "0"
        "renderfx"          "$RFX_GLOWSHELL2"
        "needs"             "ctf_flag"
        "playerScore"       "10"
        "teamScore"         "1"
}

entityDef ctf_baseflag
{
        "spawnclass"        "ncCaptureItem"
        "mins"              "-16 -16 0"
        "maxs"              "16 16 72"
        "model"             "models/flag.vvm"
        "dropToFloor"       "1"
        "goalItem"          "ctf_flag"
        "script_gametype"   "ctf"

        "rendermode"        "0"
        "renderamt"         "32"
        "renderfx"          "$RFX_GLOWSHELL"

        // doubles as a capture point!
        "needs"             "ctf_flag"
        "playerScore"       "10"
        "teamScore"         "1"
}

// the actual inventory item
entityDef ctf_flag
{
        "editor_model"      "models/flag.vvm"
        "spawnclass"        "ncItem"
        "mins"              "-16 -16 0"
        "maxs"              "16 16 72"
        "inv_carry"         "1"
        "model"             "models/flag.vvm"
}

entityDef team_CTF_redflag
{
        "inherit"           "ctf_baseflag"
        "rendercolor"       "255 0 0"
        "goal_no"           "1"
        "skin"              "2"
        "model"             "models/flag.vvm"

        "OnTake"            "!rules,take,1,0.0,-1"
        "OnDrop"            "!rules,drop,1,0.0,-1"
        "OnReturn"          "!rules,return,1,0.0,-1"
        "OnCapture"         "!rules,capture,1,0.0,-1"
}


