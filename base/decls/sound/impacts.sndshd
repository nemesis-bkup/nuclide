DoSpark
{
	attenuation idle
	pitch_min 90
	pitch_max 110
	sample buttons/spark1.wav
	sample buttons/spark2.wav
	sample buttons/spark3.wav
	sample buttons/spark4.wav
	sample buttons/spark5.wav
	sample buttons/spark6.wav
}

